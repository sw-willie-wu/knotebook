{
  "name": "knotebook",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "esbuild"],
    "patchedDependencies": { "y-prosemirror@1.3.7": "patches/y-prosemirror@1.3.7.patch" }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r exec tsc --noEmit && pnpm --filter @knotebook/shared typecheck:test && pnpm --filter @knotebook/server typecheck:test",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --filter @knotebook/shared build && pnpm -r test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check-licenses": "node scripts/check-licenses.mjs",
    "release:prepare": "node scripts/release-prepare.mjs"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  }
}
