{
  "name": "knotebook",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.14.0",
  "pnpm": { "onlyBuiltDependencies": ["argon2", "esbuild"] },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r exec tsc --noEmit && pnpm --filter @knotebook/server typecheck:test",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check-licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
