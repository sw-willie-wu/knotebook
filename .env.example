# Which prebuilt image `docker compose` runs: ghcr.io/sw-willie-wu/knotebook:<KNOTEBOOK_VERSION>
# (read by docker-compose.yml, not by the server). Unset means the release's own version with the
# docker-compose.yml attached to a GitHub Release, and `latest` with the repository's docker-compose.yml.
# With the repository's file, pinning a release is recommended, e.g. 0.11.1 (no leading "v"), so the version
# only changes when you change it here; `0.11` follows that line's patch releases. Images are published from
# v0.11.1 on, for linux/amd64 and linux/arm64.
# See docs/self-hosting.md "The app image" and "Upgrading and rolling back".
# KNOTEBOOK_VERSION=0.11.1

# Database connection URL
# Format: postgres://user:password@host:port/dbname
# For local development with docker-compose, use the service name: postgres://knotebook:knotebook@db:5432/knotebook
# For local development without docker, use: postgres://knotebook:knotebook@localhost:5432/knotebook
DATABASE_URL=postgres://knotebook:knotebook@db:5432/knotebook

# Optional: use your own PostgreSQL instead of the bundled one (read by docker-compose.yml, not by the server).
# By default `docker compose up -d` also starts the bundled PostgreSQL (the `db` service) and the
# DATABASE_URL above points at it. To use a PostgreSQL server you run yourself, point DATABASE_URL at it and
# set BUNDLED_DB=0: the `db` container is then not started, and `app` doesn't wait for it.
# Only 0 or 1 (the default); any other value makes docker compose fail. From inside the container, `localhost` is the container itself: for a
# PostgreSQL on the machine running Docker, use host.docker.internal as the host.
# See docs/self-hosting.md "Using your own PostgreSQL".
# BUNDLED_DB=0

# Optional database connection pool fuse (#175). Defaults shown.
# DATABASE_POOL_MAX: maximum number of database connections the server opens (no upper bound is enforced;
# keep it below your Postgres max_connections).
# DATABASE_POOL_CONNECTION_TIMEOUT_MS: how long a request waits for a free connection before failing
# (maximum 2147483647);
# when every connection stays busy that long, the request fails with a server error and the server
# logs an error, instead of hanging. This is a safety net, not a capacity knob: raising
# DATABASE_POOL_MAX does not fix a request that holds one connection while waiting for another.
# See docs/self-hosting.md.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# Optional: the parse workers that read Markdown written over MCP and the API (#398). Defaults shown, except
# PARSE_WORKERS, whose default is the smaller of one less than the CPUs the server may use (at most 4) and
# floor(memory x 0.5 / PARSE_WORKER_MEMORY_MB), at least 1. In a container, the CPUs and memory counted are its
# limits (cgroup; see the commented-out deploy.resources.limits in docker-compose.yml), not the host's.
# Each worker uses about 120 MB idle and up to about PARSE_WORKER_MEMORY_MB while reading.
# PARSE_WORKERS: 1 to 32.
# PARSE_WORKER_MEMORY_MB: each worker's memory limit in MiB, 128 to 16384; a write that needs more is refused.
# PARSE_TIMEOUT_MS: how long reading one write may take, 100 to 2147483647; a write that takes longer is refused.
# PARSE_QUEUE_WAIT_MS: how long a read or write may wait for a free worker before answering 503, 100 to 2147483647;
# unset, 4 x PARSE_TIMEOUT_MS + 5000 (45000 by default).
# Any other value stops the server from starting. See docs/self-hosting.md "Parse workers" for how to choose them.
# Setting one of these locks that field in Site admin -> Site limits (the variable wins); leave it unset to change it there.
# PARSE_WORKERS=1
# PARSE_WORKER_MEMORY_MB=1024
# PARSE_TIMEOUT_MS=10000
# PARSE_QUEUE_WAIT_MS=45000

# Note size limit (optional): the largest a note may grow to, in bytes of its stored state (1 to 1073741824,
# default 5242880 = 5 MiB). A change that would make a note larger than this and larger than it was, and adds content (or grows it by more than 4 KiB without adding content), is refused;
# notes already larger still open and read. See docs/self-hosting.md "Note size".
# Setting it locks that field in Site admin -> Site limits (the variable wins); leave it unset to change it there.
# NOTE_MAX_BYTES=5242880

# Application secret for signing and encryption
# Must be 64+ hexadecimal characters (e.g., output of `openssl rand -hex 32`)
# Generate with: openssl rand -hex 32
APP_SECRET=

# Public URL for the application
# Use https for public deployments (behind a reverse proxy that terminates TLS)
# Plain http is also allowed on a trusted LAN (e.g. http://<lan-ip>:3000) — the
# server will start but logs a loud warning; see docs/self-hosting.md "Deployment prerequisites"
# Example for local: http://localhost:3000
# Example for trusted LAN: http://192.168.1.50:3000
# Example for public: https://notes.example.com
PUBLIC_URL=

# Optional: whether to believe the X-Forwarded-For header (and the other forwarding headers).
# Rate limiting and login lockout are keyed on the client address, so this decides what counts
# as "the client". Leave it unset when clients can reach this app directly (trusted-LAN mode,
# or any topology someone could route around) — a header anyone can set must not be believed.
#
# SET IT IF YOU RUN BEHIND A REVERSE PROXY: otherwise every visitor arrives as the proxy's
# address and shares one rate-limit bucket, so five bad passwords from anyone lock out everybody.
# Values: a list of trusted proxy addresses (IPs, CIDRs, or loopback/linklocal/uniquelocal),
# a hop count (1 for a single proxy), or true to trust the header from any source.
# Your proxy must actually send X-Forwarded-For (nginx does not by default:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;)
# and should pass the original Host through, or image uploads will fail with 403.
# See docs/self-hosting.md "Deployment prerequisites".
# TRUST_PROXY=172.16.0.0/12

# Required on first boot: creates the first (admin) account at startup. This is the only way
# to initialize a fresh instance — the server refuses to start on an empty/uninitialized
# database without both of these set. Set BOTH or NEITHER — setting only one fails the server
# to start with a clear error. ADMIN_PASSWORD must be 12+ characters.
#
# This only takes effect on first initialization (empty database, not yet initialized) — same
# behavior as POSTGRES_PASSWORD in docker-compose.yml (see docs/known-limitations.md): once an
# instance is initialized, these variables are silently ignored on every subsequent start, no
# error or warning.
# After first login, consider removing these two lines from .env — leaving a plaintext
# password there is no longer useful once the account exists, and it's one less secret to leak.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OpenID Connect (SSO) sign-in is set up in Site admin → Sign-in (/admin/auth), not here.

# Recovery switch. When Site admin → Sign-in has password sign-in turned off and you can no longer sign in
# through SSO, set this to true and restart: password sign-in is accepted again regardless of the setting
# (the setting itself is not changed). Remove it after recovery. Only `true` or `false` (case-insensitive)
# is accepted (empty counts as not set); any other value stops the server from starting.
# PASSWORD_LOGIN_FORCE_ENABLE=true
