{
  "name": "@knotebook/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "stack:up": "docker compose -p ${E2E_PROJECT:-knotebook-e2e} -f ../docker-compose.yml -f ../docker-compose.e2e.yml up --build --wait --wait-timeout 300",
    "stack:down": "docker compose -p ${E2E_PROJECT:-knotebook-e2e} -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "stack:ps": "docker compose -p ${E2E_PROJECT:-knotebook-e2e} -f ../docker-compose.yml -f ../docker-compose.e2e.yml ps -a",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
