{
  "name": "@knotebook/server",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter @knotebook/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @knotebook/shared build && vitest run --passWithNoTests",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "pnpm --filter @knotebook/shared build && vitest run test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cookie": "^11",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@hocuspocus/server": "^4.5.0",
    "@knotebook/shared": "workspace:*",
    "argon2": "^0.44",
    "drizzle-orm": "^0.44",
    "fastify": "^5",
    "jose": "^6",
    "openid-client": "^6.8.5",
    "pg": "^8",
    "pino": "^10",
    "ws": "^8.21.2",
    "yjs": "^13.6.32",
    "zod": "^3"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.5.0",
    "@testcontainers/postgresql": "^11",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "typescript": "^5.6.0",
    "vitest": "^3"
  }
}
