{
  "name": "@knotebook/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "pnpm --filter @knotebook/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @knotebook/shared build && vitest run --passWithNoTests",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@knotebook/shared": "workspace:*",
    "fastify": "^5",
    "@fastify/cookie": "^11",
    "drizzle-orm": "^0.44",
    "pg": "^8",
    "argon2": "^0.44",
    "jose": "^6",
    "pino": "^10",
    "zod": "^3",
    "@hocuspocus/server": "^4.5.0",
    "yjs": "^13.6.32",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4",
    "vitest": "^3",
    "@testcontainers/postgresql": "^11",
    "drizzle-kit": "^0.31",
    "@types/pg": "^8",
    "@types/node": "^22",
    "@hocuspocus/provider": "^4.5.0",
    "@types/ws": "^8.18.1"
  }
}
